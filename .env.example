# ══════════════════════════════════════════════════════════════════════
# CRIMENET AI — EXAMPLE ENVIRONMENT CONFIGURATION
# ══════════════════════════════════════════════════════════════════════
# IMPORTANT: Copy this file to .env and fill in real values.
# NEVER commit your .env file. It is listed in .gitignore.
# NEVER use the placeholder values below in any real environment.
# ══════════════════════════════════════════════════════════════════════

# Core Security & Master Secret Keys
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Minimum 64 hex characters (32 bytes of entropy). Required in production.
CRIMENET_SECRET_KEY=REPLACE_WITH_64_HEX_CHARS_cryptographically_random_secret_key
CRIMENET_JWT_SECRET=REPLACE_WITH_64_HEX_CHARS_jwt_signing_secret_key_minimum_32_bytes
CRIMENET_PII_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS_aes256_pii_encryption_key_32_bytes

# Environment Mode: 'production' or 'development'
# production: fails startup on weak/default credentials
# development: ephemeral keys generated; SQLite fallback permitted
CRIMENET_ENV=development

# ── 1. POSTGRESQL & POSTGIS (PRIMARY RELATIONAL SYSTEM OF RECORD) ──
# Use strong random passwords. Never use postgres/postgres in production.
DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@localhost:5432/crimenet
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crimenet
POSTGRES_USER=REPLACE_WITH_STRONG_DB_USERNAME
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# SQLite path used ONLY in development mode (CRIMENET_ENV=development)
CRIMENET_DB_PATH=backend/crimenet.db

# ── 2. NEO4J (DEDICATED GRAPH DATABASE FOR RELATIONSHIP TRAVERSAL) ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=REPLACE_WITH_STRONG_NEO4J_PASSWORD

# ── 3. OBJECT STORAGE (S3 / MINIO / CLOUDFLARE R2) ──
# IMPORTANT: Never use minioadmin/minioadmin. The bucket must remain PRIVATE.
# Evidence access is controlled exclusively through the backend API.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=REPLACE_WITH_MINIO_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_MINIO_SECRET_KEY
S3_BUCKET_NAME=crimenet-evidence
S3_REGION=us-east-1
S3_USE_SSL=false

# ── 4. AUTHENTICATION PARAMETERS ──
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PBKDF2_ITERATIONS=100000

# Development Seed Password — used only when database is empty for the first time.
# Set a strong value here for consistent local development logins.
# NEVER set this in production; provision users through the admin interface instead.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(16))"
DEFAULT_SEED_PASSWORD=REPLACE_WITH_STRONG_SEED_PASSWORD

# ── 5. CORS ──
# Comma-separated list. No wildcard in production.
# Example: CORS_ORIGINS=https://crimenet.your-domain.com
# CORS_ORIGINS=

# ── 6. DATA PRIVACY SETTINGS ──
INTRUDER_LOG_RETENTION_DAYS=30
REQUIRE_CAMERA_CONSENT=true

# ══════════════════════════════════════════════════════════════════════
# GENERATING SECURE VALUES:
#   JWT / Secret Key:      python -c "import secrets; print(secrets.token_hex(32))"
#   PII Encryption Key:    python -c "import secrets; print(secrets.token_hex(32))"
#   DB / MinIO password:   python -c "import secrets; print(secrets.token_urlsafe(24))"
# ══════════════════════════════════════════════════════════════════════
