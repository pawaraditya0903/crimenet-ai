# ══════════════════════════════════════════════════════════════════════
# CRIMENET AI — ENTERPRISE PRODUCTION ENVIRONMENT CONFIGURATION
# ══════════════════════════════════════════════════════════════════════

# Core Security & Master Secret Keys (Cryptographically Random 32-byte Hex)
CRIMENET_SECRET_KEY=9f8e7d6c5b4a3928172635445362718293a4b5c6d7e8f9011223344556677889
CRIMENET_JWT_SECRET=a1b2c3d4e5f67890123456789abcdef0123456789abcdef0123456789abcdef0
CRIMENET_PII_ENCRYPTION_KEY=c4f7b2a9e1d83056192847563029184756201938475620193847562019384756

# Environment Mode: 'production', 'enterprise', or 'development'
CRIMENET_ENV=development

# ── 1. POSTGRESQL & POSTGIS (PRIMARY RELATIONAL SYSTEM OF RECORD) ──
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/crimenet
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crimenet
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
CRIMENET_DB_PATH=backend/crimenet.db

# ── 2. NEO4J (DEDICATED GRAPH DATABASE FOR RELATIONSHIP TRAVERSAL) ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=crimenet_graph_pass

# ── 3. OBJECT STORAGE (S3 / MINIO / CLOUDFLARE R2) ──
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=crimenet-evidence
S3_REGION=us-east-1
S3_USE_SSL=false

# Authentication Parameters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PBKDF2_ITERATIONS=100000

# Biometric & Data Privacy (DPDP Act 2023 Compliance)
INTRUDER_LOG_RETENTION_DAYS=30
REQUIRE_CAMERA_CONSENT=true
